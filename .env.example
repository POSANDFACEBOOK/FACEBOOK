# ================================================
# .env.local - Copy file นี้แล้วใส่ค่าจริง
# ================================================

# ---- Facebook App (Facebook Login + Messenger) ----
# สร้างที่: https://developers.facebook.com
FACEBOOK_CLIENT_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret_here

# verify token เป็น string สุ่มที่ตั้งเอง — ต้องตรงกับใน FB App → Webhooks → Verify Token
# Generate ด้วย: openssl rand -hex 16
FB_WEBHOOK_VERIFY_TOKEN=your_random_verify_token_here

# ---- Supabase ----
# สร้างที่: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ใช้ให้แชทเด้งทันที (Realtime) — ถ้าไม่ตั้ง ระบบจะดึงข้อความใหม่ทุกไม่กี่วินาทีแทน
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ---- Anthropic Claude AI (ปุ่ม "AI ช่วยตอบ") ----
# สร้างที่: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ---- NextAuth ----
NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://your-app.vercel.app

# Generate ด้วย: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_32_char_secret_here

# ---- ช่องทาง LINE OA (ซ่อนไว้ก่อน) ----
# ไม่ตั้ง/false = ซ่อน LINE ทั้งระบบ (ข้อมูลเดิมไม่หาย) · true = เปิดใช้ แล้วเชื่อม OA ในหน้า "ช่องทางแชท"
# ⚠️ เปลี่ยนค่าแล้วต้อง Redeploy ใน Vercel ถึงจะมีผล
NEXT_PUBLIC_ENABLE_LINE=false
